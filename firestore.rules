rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Help function to determine if user is authenticated
    function isAuth() {
      return request.auth != null;
    }

    // Contas de administracao reconhecidas pelo proprio e-mail do token. O
    // e-mail vem assinado pelo Firebase Auth: o cliente nao consegue forjar,
    // ao contrario do papel gravado em users/{uid}.
    function isAdminEmail() {
      return isAuth() && (
        request.auth.token.email == 'brisasofc@gmail.com' ||
        request.auth.token.email == 'natandsantosmarinho10@gmail.com' ||
        request.auth.token.email == 'isaacbomfim.te@gmail.com' ||
        request.auth.token.email == 'isaacbomfim.00@gmail.com'
      );
    }

    // Check if the current user profile is marked as admin or is an authorized admin email
    function isAdmin() {
      return isAuth() && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin') ||
        isAdminEmail()
      );
    }

    // Credencial de operador referenciada por um perfil. Usada para conferir,
    // no servidor, que o papel que alguem gravou em users/{uid} e mesmo o da
    // credencial com que essa pessoa entrou.
    function credentialOf(credId) {
      return get(/databases/$(database)/documents/custom_credentials/$(credId)).data;
    }

    // Helper to get user profile data
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Helper to check user roles
    function isVendedor() {
      return isAuth() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getUserData().role == 'vendedor';
    }

    function isAlimentador() {
      return isAuth() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        (getUserData().role == 'alimentador' || getUserData().role == 'user');
    }

    // Empresa gravada no perfil de quem esta logado. Vazio quando a credencial
    // foi criada como "Todas as Empresas" — nesse caso nao existe "a minha loja",
    // e toda regra que limita alguem ao proprio quintal tem que recusar.
    function myCompanyId() {
      return getUserData().get('companyId', '');
    }

    // Um DONO DA EMPRESA (alimentador) administra as credenciais dos VENDEDORES
    // da propria loja — e SO essas. Nunca a de outro dono, nunca a de outra
    // empresa, e nunca uma credencial de admin: o papel tem que ser exatamente
    // 'vendedor' dos dois lados da escrita, senao o dono se promoveria sozinho
    // criando um admin e entrando com ele.
    function isOwnSellerCredential(data) {
      return isAlimentador() &&
        myCompanyId() != '' &&
        data.get('role', '') == 'vendedor' &&
        data.get('companyId', '') == myCompanyId();
    }

    // ─────────────────────────────────────────────────────────────
    // Users Collection rules
    //
    // Este documento e a base de TODA a autorizacao do sistema: isAdmin(),
    // isVendedor() e isAlimentador() leem users/{uid}.role, e as regras de
    // stock, movements e transfers dependem dos tres.
    //
    // ANTES: 'allow read, write: if isAuth()'. Qualquer sessao autenticada
    // podia escrever qualquer perfil — o proprio, para se declarar admin, ou o
    // dos outros. E autenticar era trivial: a tela de login abre uma sessao
    // anonima antes de validar a senha. Na pratica, qualquer visitante virava
    // administrador do banco inteiro.
    //
    // AGORA cada um so escreve o PROPRIO perfil, e o papel e a empresa
    // gravados tem que bater com os de uma credencial que existe de verdade:
    // o login manda em 'credentialId' qual credencial usou (AuthScreen), e a
    // regra confere no servidor. Ninguem escolhe o proprio papel.
    // ─────────────────────────────────────────────────────────────
    match /users/{userId} {
      // Nenhuma tela le esta colecao (as regras leem por get(), que ignora
      // estas linhas). Fica legivel para o proprio dono e para o admin.
      allow read: if isAuth() && (request.auth.uid == userId || isAdmin());

      allow write: if isAdmin() || (
        isAuth() &&
        request.auth.uid == userId &&
        (
          // Os e-mails de administracao entram por credenciais de emergencia
          // embutidas no proprio AuthScreen, que nao existem no banco — nao ha
          // documento para conferir, e o e-mail do token ja e prova suficiente.
          isAdminEmail() ||
          (
            request.resource.data.credentialId is string &&
            request.resource.data.credentialId != '' &&
            exists(/databases/$(database)/documents/custom_credentials/$(request.resource.data.credentialId)) &&
            request.resource.data.role == credentialOf(request.resource.data.credentialId).get('role', 'user') &&
            request.resource.data.get('companyId', '') == credentialOf(request.resource.data.credentialId).get('companyId', '')
          )
        )
      );
    }

    // Companies Collection rules
    match /companies/{companyId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────────
    // Custom Credentials Collection rules
    //
    // ATENCAO: a senha ainda e gravada em texto puro e conferida no navegador.
    // Enquanto for assim, quem consegue LER um documento daqui le a senha dele.
    // A correcao definitiva e tirar a conferencia do cliente (Firebase Auth
    // e-mail/senha ou um endpoint no backend); ate la, estas regras reduzem a
    // exposicao ao minimo possivel sem quebrar o login.
    //
    // ANTES: 'allow read: if isAuth()' — e read inclui LIST. Qualquer sessao
    // autenticada, inclusive a anonima aberta pela tela de login, baixava a
    // colecao INTEIRA numa requisicao: usuario, senha e empresa de todo mundo.
    // ─────────────────────────────────────────────────────────────
    match /custom_credentials/{credId} {
      // GET de um documento por id: e assim que a troca de senha le a propria
      // credencial (App.tsx) e como as regras de users conferem o papel.
      allow get: if isAuth();

      // LIST: o admin varre a colecao inteira (tela de Operadores e Senhas).
      //
      // O DONO DA EMPRESA lista apenas os VENDEDORES da propria loja — e o
      // Firestore so libera isso porque a consulta do cliente carrega os dois
      // filtros que a regra exige (role == 'vendedor' e companyId == a dele).
      // Uma consulta sem esses filtros nao e "provavelmente segura" para o
      // servidor e cai inteira, que e exatamente o comportamento desejado:
      // ninguem raspa credencial de outra empresa por aqui.
      //
      // O login continua consultando por usuario, mas obrigatoriamente com
      // limite pequeno (AuthScreen usa limit(5)) — o que derruba o despejo da
      // colecao de uma vez. Consulta sem limite por quem nao e admin: negada.
      allow list: if isAdmin() ||
        (
          isAlimentador() &&
          myCompanyId() != '' &&
          resource.data.role == 'vendedor' &&
          resource.data.companyId == myCompanyId()
        ) ||
        (isAuth() && request.query.limit <= 5);

      allow create: if isAuth() && (
        isAdmin() ||
        // O dono cadastra os proprios vendedores. O papel e a empresa vem
        // travados do servidor, nao do formulario: nao adianta o cliente mandar
        // role 'admin' ou a empresa do vizinho.
        isOwnSellerCredential(request.resource.data) ||
        (request.resource.data.associatedEmail == 'brisasofc@gmail.com' && (request.resource.data.username == 'brisas' || request.resource.data.username == 'central')) ||
        (request.resource.data.associatedEmail == 'natandsantosmarinho10@gmail.com' && request.resource.data.username == 'natand')
      );
      // Admin can update/delete anything.
      // Operators can update their own password, but cannot change their other profile metadata (role, company, username, etc.)
      allow update: if isAdmin() || (
        // Dono editando um vendedor da casa: o documento tem que ser um vendedor
        // dele ANTES e DEPOIS da escrita. As duas metades importam — sem a
        // segunda, ele editaria o proprio vendedor para virar admin.
        isOwnSellerCredential(resource.data) &&
        isOwnSellerCredential(request.resource.data)
      ) || (
        isAuth() && resource.data.associatedEmail == request.auth.token.email &&
        request.resource.data.username == resource.data.username &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.associatedEmail == resource.data.associatedEmail &&
        request.resource.data.companyId == resource.data.companyId &&
        request.resource.data.companyName == resource.data.companyName
      );
      allow delete: if isAdmin() || isOwnSellerCredential(resource.data);
    }

    // Stock Collection rules
    match /stock/{itemId} {
      // Leitura pública habilitada para a rota de consulta sem login
      allow read: if true;

      // Admin can create anything. Donos/Alimentadores can only create for their own company.
      allow create: if isAdmin() || (
        isAlimentador() &&
        request.resource.data.companyId == getUserData().companyId
      );

      // Admin can update anything. Donos/Alimentadores can only update their own company's items.
      //
      // TRAVA DE RESERVA: `reservedQuantity` guarda quantas unidades ja foram
      // prometidas a outra empresa por uma transferencia aprovada. O saldo do
      // documento nunca pode terminar abaixo desse numero — e assim que "pneu
      // reservado nao pode receber baixa" deixa de depender da tela e passa a
      // ser garantido pelo banco. Documentos sem o campo (todo o estoque antigo)
      // resolvem para 0 e seguem exatamente como antes.
      allow update: if isAdmin() || (
        isAlimentador() &&
        resource.data.companyId == getUserData().companyId &&
        request.resource.data.companyId == getUserData().companyId &&
        (
          request.resource.data.get('reservedQuantity', 0) == 0 ||
          request.resource.data.get('quantity', 0) >= request.resource.data.get('reservedQuantity', 0)
        )
      );

      // Admin can delete anything. Donos/Alimentadores can only delete their own company's items.
      // Um item com reserva ativa nao pode ser apagado: o pedido da outra empresa
      // ficaria apontando para um documento inexistente.
      allow delete: if isAdmin() || (
        isAlimentador() &&
        resource.data.companyId == getUserData().companyId &&
        resource.data.get('reservedQuantity', 0) == 0
      );
    }

    // Movements Collection rules (Audit Logs)
    match /movements/{movementId} {
      // Admins and Vendedores can read all movements.
      // Alimentadores (Company Owners) can only read their own company's movements.
      allow read: if isAdmin() || isVendedor() || (
        isAuth() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        resource.data.companyId == getUserData().companyId
      );

      // Admin can create. Donos/Alimentadores can only log movements for their own company.
      allow create: if isAdmin() || (
        isAlimentador() &&
        request.resource.data.companyId == getUserData().companyId
      );

      // Audit logs are read-only and cannot be updated or deleted by normal users
      allow update, delete: if isAdmin();
    }

    // Transfers Collection rules (Inter-company stock transfer requests with dual signature)
    match /transfers/{transferId} {
      // A user is considered a "party" to a transfer if they belong to either the
      // source or destination company (or are admin/vendedor, who can see everything).
      function isPartyToTransfer(data) {
        return isAdmin() || isVendedor() || (
          isAlimentador() &&
          (data.sourceCompanyId == getUserData().companyId ||
           data.destinationCompanyId == getUserData().companyId)
        );
      }

      // Admin, vendedor, or an alimentador belonging to either company involved can read.
      allow read: if isPartyToTransfer(resource.data);

      // Admin, or an alimentador of the SOURCE or DESTINATION company, can create a transfer request.
      // Must be a valid, unsigned, freshly-requested transfer between two different companies.
      //
      // IMPORTANTE: um pedido carrega uma LISTA de itens (`items`), nao mais um unico
      // par sku/quantity no topo do documento. A regra antiga exigia
      // `request.resource.data.quantity is number`, campo que o app parou de enviar
      // quando a transferencia passou a aceitar varios pneus — e por isso TODA criacao
      // de transferencia por alimentador vinha sendo negada com "Missing or
      // insufficient permissions". A validacao correta e sobre a lista de itens.
      allow create: if isAdmin() || (
        isAlimentador() &&
        (request.resource.data.sourceCompanyId == getUserData().companyId || request.resource.data.destinationCompanyId == getUserData().companyId) &&
        request.resource.data.sourceCompanyId != request.resource.data.destinationCompanyId &&
        request.resource.data.items is list &&
        request.resource.data.items.size() > 0 &&
        request.resource.data.items.size() <= 100 &&
        request.resource.data.requestedByUid == request.auth.uid &&
        request.resource.data.delivery == null &&
        request.resource.data.receipt == null &&
        // RESERVA NO NASCIMENTO: um ENVIO aberto pela propria loja de ORIGEM ja
        // nasce reservado — o pneu prometido sai do saldo vendavel no instante em
        // que o pedido existe, sem esperar assinatura nenhuma. So a origem pode
        // faze-lo, porque so ela consegue somar `reservedQuantity` nos proprios
        // itens (regras de /stock), e o app grava as duas coisas na mesma transacao.
        //
        // Uma SOLICITACAO continua nascendo sem reserva: quem a abre e o DESTINO,
        // que nao escreve no estoque alheio. La a reserva entra no aval (regra e).
        (
          request.resource.data.get('reservation', null) == null || (
            request.resource.data.sourceCompanyId == getUserData().companyId &&
            request.resource.data.status != 'SOLICITADO' &&
            request.resource.data.reservation.get('active', false) == true &&
            request.resource.data.reservation.reservedByUid == request.auth.uid
          )
        ) &&
        (
          (request.resource.data.scheduledFor == null && request.resource.data.status == 'PENDENTE') ||
          (request.resource.data.scheduledFor is timestamp &&
           request.resource.data.scheduledFor > request.time &&
           request.resource.data.status == 'AGENDADO') ||
          // SOLICITACAO (pull): quem PEDE e a empresa de DESTINO, e o pedido nasce
          // parado em SOLICITADO ate a origem decidir. Nada de estoque se move nem
          // se reserva na criacao.
          (request.resource.data.status == 'SOLICITADO' &&
           request.resource.data.destinationCompanyId == getUserData().companyId)
        )
      ) || (
        // RESERVA DE CLIENTE: o vendedor separa pneus de uma LOJA para o cliente
        // final dele. O destino 'CLIENTE' e um sentinela — nao existe empresa com
        // esse id, e nenhum usuario pertence a ela. Por isso o pedido nasce parado
        // em SOLICITADO, sem reserva e sem agendamento: ele so prende saldo quando
        // a loja de origem aprovar (regra e), e so e encerrado por ela (regra h).
        isVendedor() &&
        request.resource.data.destinationCompanyId == 'CLIENTE' &&
        request.resource.data.sourceCompanyId != 'CLIENTE' &&
        request.resource.data.status == 'SOLICITADO' &&
        request.resource.data.requestKind == 'SOLICITACAO' &&
        request.resource.data.scheduledFor == null &&
        request.resource.data.items is list &&
        request.resource.data.items.size() > 0 &&
        request.resource.data.items.size() <= 100 &&
        request.resource.data.requestedByUid == request.auth.uid &&
        // O nome do cliente e o que a loja ve no pedido e o que vai para o
        // historico de saida quando a venda fechar — sem ele o registro fica cego.
        request.resource.data.customerName is string &&
        request.resource.data.customerName.size() > 0 &&
        request.resource.data.customerName.size() <= 200 &&
        request.resource.data.delivery == null &&
        request.resource.data.receipt == null &&
        request.resource.data.get('reservation', null) == null
      );

      // Updates are split into narrow, field-locked transitions. Each branch only allows
      // the specific fields relevant to that action to change (everything else must stay
      // identical to the existing document), so a client cannot smuggle unrelated field
      // changes (e.g. quantity, destination company) into a signature/status update.
      allow update: if isAdmin() || (
        // (a) Scheduled order becomes due: any involved party's client (the app's
        // heartbeat check) can flip AGENDADO -> PENDENTE, but ONLY once the scheduled
        // time has actually passed, and ONLY the status/updatedAt fields may change.
        isPartyToTransfer(resource.data) &&
        resource.data.status == 'AGENDADO' &&
        request.resource.data.status == 'PENDENTE' &&
        resource.data.scheduledFor is timestamp &&
        request.time >= resource.data.scheduledFor &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
      ) || (
        // (b0) Assinatura do REMETENTE isolada: o responsavel da origem assina e
        // ja fica gravado, sem mover o pedido. O status so vira EM_TRANSITO na
        // regra (b), quando a assinatura do motorista chegar. Nada de estoque se
        // move aqui — e so a coleta da primeira das duas vias da saida.
        isAlimentador() &&
        resource.data.sourceCompanyId == getUserData().companyId &&
        resource.data.destinationCompanyId != 'CLIENTE' &&
        resource.data.status == 'PENDENTE' &&
        request.resource.data.status == 'PENDENTE' &&
        request.resource.data.dispatch.sender.signedByUid == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['dispatch', 'delivery', 'updatedAt'])
      ) || (
        // (c0) Assinatura do RECEBEDOR isolada: mesma ideia no lado do destino.
        // O pedido so vira CONCLUIDO na regra (c), com a via do motorista.
        isAlimentador() &&
        resource.data.destinationCompanyId == getUserData().companyId &&
        resource.data.status == 'EM_TRANSITO' &&
        request.resource.data.status == 'EM_TRANSITO' &&
        request.resource.data.arrival.receiver.signedByUid == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['arrival', 'receipt', 'updatedAt'])
      ) || (
        // (b) Delivery signature: only an alimentador of the SOURCE company, only while
        // PENDENTE, transitioning to EM_TRANSITO, only touching status/delivery/updatedAt.
        isAlimentador() &&
        resource.data.sourceCompanyId == getUserData().companyId &&
        resource.data.destinationCompanyId != 'CLIENTE' &&
        resource.data.status == 'PENDENTE' &&
        request.resource.data.status == 'EM_TRANSITO' &&
        // A via do remetente ja precisa existir (gravada na regra b0). A via do
        // motorista nao carrega uid: ele assina por link publico ou em papel,
        // sem login — por isso aqui nao se compara signedByUid com auth.uid.
        resource.data.dispatch.sender.signedByUid is string &&
        // 'reservation' entra aqui porque o despacho converte a reserva em saida
        // real: os pneus deixam o estoque e o bloqueio deixa de existir, na mesma
        // transacao que decrementa quantity/reservedQuantity.
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'delivery', 'dispatch', 'reservation', 'updatedAt'])
      ) || (
        // (c) Receipt signature: only an alimentador of the DESTINATION company, only
        // while EM_TRANSITO, transitioning to CONCLUIDO.
        isAlimentador() &&
        resource.data.destinationCompanyId == getUserData().companyId &&
        resource.data.status == 'EM_TRANSITO' &&
        request.resource.data.status == 'CONCLUIDO' &&
        // Mesma logica da regra (b): a via do recebedor ja tem que estar
        // gravada (regra c0) e a via do motorista chega sem uid.
        resource.data.arrival.receiver.signedByUid is string &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'receipt', 'arrival', 'destinationStockItemId', 'updatedAt'])
      ) || (
        // (d) Pre-dispatch cancellation: an alimentador of the SOURCE or DESTINATION company,
        // or the Vendedor who created it, only while AGENDADO, PENDENTE or SOLICITADO (nothing has physically moved yet).
        (
          (isAlimentador() && (resource.data.sourceCompanyId == getUserData().companyId || resource.data.destinationCompanyId == getUserData().companyId)) ||
          (isVendedor() && resource.data.requestedByUid == request.auth.uid)
        ) &&
        (resource.data.status == 'AGENDADO' || resource.data.status == 'PENDENTE' || resource.data.status == 'SOLICITADO') &&
        request.resource.data.status == 'CANCELADO' &&
        // Pedido com reserva ativa segura pneus no estoque da ORIGEM, e so a origem
        // consegue devolve-los (as regras de stock so deixam cada empresa escrever
        // nos proprios itens). Por isso o DESTINO nao cancela um pedido reservado —
        // se pudesse, o cancelamento passaria mas a reserva ficaria presa para sempre.
        (
          resource.data.get('reservation', null) == null ||
          resource.data.reservation.get('active', false) != true ||
          (isAlimentador() && resource.data.sourceCompanyId == getUserData().companyId)
        ) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledByUid', 'cancelledByName', 'cancelledAt', 'cancelReason', 'reservation', 'updatedAt'])
      ) || (
        // (e) A ORIGEM aprova uma solicitacao. O app faz isso na mesma transacao
        // em que soma `reservedQuantity` nos itens do proprio estoque — entre o
        // aval e a reserva nao existe janela em que o pneu esteja prometido e
        // ainda vendavel.
        isAlimentador() &&
        resource.data.sourceCompanyId == getUserData().companyId &&
        resource.data.status == 'SOLICITADO' &&
        (request.resource.data.status == 'PENDENTE' || request.resource.data.status == 'AGENDADO') &&
        // O destino de um pedido e imutavel, com UMA excecao: a reserva de
        // cliente aberta por um vendedor de OUTRA filial. O pneu esta aqui e o
        // cliente esta la, entao aprovar tem que colocar o pneu a caminho —
        // o destino sai do balcao ('CLIENTE') e passa a ser a loja de quem pediu,
        // e o pedido vira uma transferencia comum, com as quatro assinaturas.
        //
        // A troca so pode apontar para a loja registrada no proprio pedido
        // (`requestedByCompanyId`, gravado na criacao): quem aprova nao escolhe
        // o destino, so confirma o que o vendedor ja tinha declarado.
        (
          request.resource.data.destinationCompanyId == resource.data.destinationCompanyId || (
            resource.data.destinationCompanyId == 'CLIENTE' &&
            resource.data.get('requestedByCompanyId', '') != '' &&
            resource.data.get('requestedByCompanyId', '') != resource.data.sourceCompanyId &&
            request.resource.data.destinationCompanyId == resource.data.requestedByCompanyId
          )
        ) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'reservation', 'approvedByUid', 'approvedByName', 'approvedAt', 'destinationCompanyId', 'destinationCompanyName', 'updatedAt'])
      ) || (
        // (f) A ORIGEM recusa a solicitacao. Nada foi reservado, entao e so status.
        isAlimentador() &&
        resource.data.sourceCompanyId == getUserData().companyId &&
        resource.data.status == 'SOLICITADO' &&
        request.resource.data.status == 'RECUSADO' &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'rejectedByUid', 'rejectedByName', 'rejectedAt', 'rejectReason', 'updatedAt'])
      ) || (
        // (g) A ORIGEM reserva ou libera os itens de um pedido ja pendente/agendado,
        // sem mexer no status. Serve para segurar mercadoria que ainda vai demorar
        // a sair, e para desistir da reserva sem cancelar o pedido.
        isAlimentador() &&
        resource.data.sourceCompanyId == getUserData().companyId &&
        (resource.data.status == 'AGENDADO' || resource.data.status == 'PENDENTE') &&
        request.resource.data.status == resource.data.status &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reservation', 'updatedAt'])
      ) || (
        // (h) CONCLUSAO DA VENDA de uma reserva de cliente. Sem esta regra, o
        // botao "Concluir Venda" batia em permission-denied: a regra (c), a unica
        // que leva um pedido a CONCLUIDO, exige EM_TRANSITO e um alimentador da
        // empresa de DESTINO — e ninguem pertence a empresa sentinela 'CLIENTE'.
        //
        // Quem fecha e a LOJA DE ORIGEM, na mesma transacao em que debita
        // quantity e devolve reservedQuantity no proprio estoque (as regras de
        // stock ja garantem que ela so escreve nos itens dela). O pedido nao passa
        // por EM_TRANSITO: o pneu vai da prateleira direto para a mao do cliente.
        isAlimentador() &&
        resource.data.destinationCompanyId == 'CLIENTE' &&
        resource.data.sourceCompanyId == getUserData().companyId &&
        (resource.data.status == 'PENDENTE' || resource.data.status == 'AGENDADO') &&
        request.resource.data.status == 'CONCLUIDO' &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'reservation', 'saleCompletedByUid', 'saleCompletedByName', 'saleCompletedAt', 'updatedAt'])
      );

      // Only admin can hard-delete a transfer record (e.g. cleaning up test data).
      allow delete: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────────
    // Signature Requests: link publico de assinatura do motorista
    //
    // O motorista NAO tem login. Ele abre um link com um token aleatorio de
    // 32 caracteres (o proprio id do documento) e assina ali. O documento
    // carrega uma copia do que ele precisa ver (empresas, itens) para que a
    // colecao transfers continue fechada para quem nao esta autenticado.
    // ─────────────────────────────────────────────────────────────
    match /signature_requests/{token} {

      // get: qualquer um que TENHA o token le aquele documento — e assim que a
      // pagina publica funciona. list fica restrito a usuarios autenticados,
      // senao um anonimo poderia varrer a colecao inteira e assinar todos os
      // pedidos pendentes sem nunca ter recebido link nenhum.
      allow get: if true;
      allow list: if isAdmin() || isAlimentador();

      // Só quem opera o estoque gera um pedido de assinatura.
      allow create: if (isAdmin() || isAlimentador()) &&
        request.resource.data.status == 'PENDENTE' &&
        request.resource.data.signatureDataUrl == '' &&
        request.resource.data.expiresAt is timestamp;

      allow update: if
        // (1) O motorista anonimo: carimba a assinatura UMA vez, apenas
        // enquanto o pedido esta pendente e dentro da validade, e so pode
        // tocar nos campos da propria assinatura. Nao alcanca itens,
        // transferId nem validade.
        (
          resource.data.status == 'PENDENTE' &&
          request.time < resource.data.expiresAt &&
          request.resource.data.status == 'ASSINADO' &&
          request.resource.data.signatureDataUrl is string &&
          request.resource.data.signatureDataUrl.size() > 0 &&
          request.resource.data.signatureDataUrl.size() < 700000 &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'signatureDataUrl', 'signedAt', 'signedDriverName'])
        )
        // (2) O painel autenticado: marca como aplicada ou cancela o link.
        || (
          (isAdmin() || isAlimentador()) &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'appliedAt', 'cancelledAt'])
        );

      allow delete: if isAdmin();
    }
  }
}
